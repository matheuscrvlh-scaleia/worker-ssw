# Copiar para .env e preencher. Opcional não usado fica comentado (vazio o boot recusa).

DATABASE_URL=postgres://erp_worker.<projeto>:<senha>@<host>:5432/postgres?sslmode=verify-full&sslrootcert=/etc/erp/certs/supabase-ca.crt
REDIS_SENHA=
INTERNO_TOKENS=
SEGREDOS_CHAVES=
SEGREDOS_CHAVE_ATUAL=1
AGENDAMENTOS_LIGADOS=false

# INGESTAO_JOBS_LIGADOS=
# METRICAS_TOKEN=
# LOG_NIVEL=info
