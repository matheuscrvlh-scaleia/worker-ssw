# Copiar para .env e preencher. Opcional não usado fica comentado (vazio o boot recusa).

# Papel erp_worker no postgres do compose do ERP (rede erp_banco, sem TLS: não sai do host).
DATABASE_URL=postgres://erp_worker:<senha>@postgres:5432/postgres
REDIS_SENHA=
INTERNO_TOKENS=
SEGREDOS_CHAVES=

# AGENDAMENTOS_LIGADOS=false
# INGESTAO_JOBS_LIGADOS=
# METRICAS_TOKEN=
# LOG_NIVEL=info
