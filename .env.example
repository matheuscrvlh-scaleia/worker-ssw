# Modelo do .env do worker-ssw (copiar para .env e preencher; o .env nunca vai para o git).
# Variável opcional fica COMENTADA quando não se usa: vazia, a validação do boot recusa.

# --- Imagem (compose) ---
# WORKER_CPUS=
# WORKER_MEMORIA=

# --- Banco: papel erp_worker, com sslmode=verify-full e sslrootcert=/etc/erp/certs/... ---
DATABASE_URL=
# DB_MAX_CONEXOES=
# DB_TIMEOUT_CONSULTA_MS=

# --- Redis próprio (o compose monta a REDIS_URL com esta senha) ---
REDIS_SENHA=
# Só fora do compose (bun run dev):
# REDIS_URL=

# --- HTTP ---
# PORTA=
# HOST=
# PROXIES_CONFIAVEIS=
# Tokens de serviço aceitos em /interno/v1 (atual,anterior), cada um com 32+ caracteres.
INTERNO_TOKENS=
# METRICAS_TOKEN=

# --- O que este processo roda ---
# WORKERS_LIGADOS=
# AGENDAMENTOS_LIGADOS=
# INGESTAO_JOBS_LIGADOS=

# --- Segredos de integração (as mesmas chaves do ERP) ---
SEGREDOS_CHAVES=
# SEGREDOS_CHAVE_ATUAL=

# --- SFTP só para integração com parametros.usar_env (transição da FR) ---
# SFTP_HOST=
# SFTP_PORTA=
# SFTP_USUARIO=
# SFTP_SENHA=
# SFTP_IMPRESSAO_DIGITAL=

# --- Desenvolvimento local ---
# NODE_ENV=
# LOG_NIVEL=
